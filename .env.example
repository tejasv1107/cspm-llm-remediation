# Copy to .env and fill in. NEVER commit the real .env file.

# --- AWS ---
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
# Comma-separated regions to poll Security Hub in
SECURITY_HUB_REGIONS=ap-south-1,us-east-1
# Comma-separated client (tenant) account IDs this deployment serves
CLIENT_ACCOUNT_IDS=111111111111,222222222222
# Optional JSON map of account_id -> tier, e.g. {"111111111111":"prod","222222222222":"non-prod"}
ACCOUNT_TIER_MAP={}

# --- Amazon Bedrock ---
# anthropic.claude-3-sonnet-20240229-v1:0 (the originally-specified model) is end-of-life on
# Bedrock. Current models need an inference-profile-prefixed ID -- run
# `aws bedrock list-inference-profiles` to see what's available in your account/region.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_MAX_TOKENS=4096
# low|medium|high|xhigh|max. "low" is deliberately cheap: this is templated/retrieval-augmented
# code generation, not open-ended reasoning. Raise it only if generated HCL quality needs it.
BEDROCK_EFFORT=low
# Optional hard cap on Bedrock calls per process, as a safety valve against runaway spend from a
# bug or a misconfigured loop. Empty = unlimited.
BEDROCK_MAX_CALLS=
# Current-generation models (Sonnet 5, Opus 5, Fable 5.1) reject `temperature` outright. Leave
# this unset unless BEDROCK_MODEL_ID points at an older model that still accepts it.
BEDROCK_TEMPERATURE=

# --- Anonymisation ---
# Secret salt mixed into the SHA-256 account-ID hash. Keep it stable, keep it private.
ANONYMISER_SALT=change-me

# --- RAG / ChromaDB ---
CHROMADB_PATH=./chroma_db
# hash (offline, deterministic) | default (Chroma MiniLM, downloads model) | bedrock (Titan embeddings)
EMBEDDER=default
TERRAFORM_MODULES_DIR=./terraform_modules

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=cspm-urgency-classifier
MLFLOW_MODEL_ALIAS=champion

# --- GitHub (approval workflow) ---
# owner/name of the repository that receives remediation PRs
GITHUB_REPO=your-org/your-remediation-repo
GITHUB_BASE_BRANCH=main
# Simplest auth: a personal access token (repo scope) for single-repo dev/demo use.
GITHUB_TOKEN=
# GitHub App auth (preferred for a real multi-tenant MSP deployment) is used instead
# whenever GITHUB_TOKEN is unset:
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=./secrets/github_app_private_key.pem

# --- Slack ---
SLACK_WEBHOOK_URL=

# --- Feedback log / baseline capture ---
DYNAMODB_FEEDBACK_TABLE=cspm-remediation-feedback
BASELINE_S3_BUCKET=
BASELINE_S3_PREFIX=baseline
BASELINE_LOOKBACK_DAYS=2

# --- Validation tooling (must be on PATH, or set full paths) ---
TERRAFORM_BIN=terraform
TFLINT_BIN=tflint
OPA_BIN=opa
